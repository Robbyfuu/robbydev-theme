{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		"lib": ["ES2022"],
		"types": ["node"],
		"outDir": "out",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"sourceMap": false,
		"rootDir": "src"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "out", ".vscode-test"]
}
